{
  "name": "turkce-duo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"messages/**/*.json\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"messages/**/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:mobile": "tsx scripts/audit-mobile.ts",
    "content:init": "tsx scripts/content-init.ts",
    "content:check": "tsx scripts/content-check.ts",
    "content:export-review": "tsx scripts/content-export-review.ts",
    "tts:sample-voices": "tsx scripts/tts/sample-voices.ts",
    "tts:generate": "tsx scripts/tts/generate.ts",
    "tts:budget": "tsx scripts/tts/budget.ts",
    "secrets:check": "tsx scripts/secret-scan.ts",
    "prepare": "tsx scripts/install-hooks.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.1",
    "dexie": "4.4.7",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.27.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
