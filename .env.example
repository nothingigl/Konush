# Public Supabase configuration (safe for browser; security is enforced via PostgreSQL RLS)
# Note: Vercel's Supabase Marketplace integration may inject NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# instead of NEXT_PUBLIC_SUPABASE_ANON_KEY — both are supported automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical site URL for SEO, Open Graph, and Auth redirects (e.g. http://localhost:3000 or https://your-domain.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Feature flag for local development: include units with review="draft" when set to "true"
NEXT_PUBLIC_INCLUDE_DRAFT_CONTENT=

# Local-only API key for offline TTS audio generation script (scripts/tts/generate.ts)
# NEVER add this variable to Vercel or GitHub Actions!
GEMINI_API_KEY=
